{
	"name": "libelli",
	"private": true,
	"version": "0.18.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"gates": "bash scripts/gates.sh",
		"lint": "eslint .",
		"test": "vitest run --config vitest.config.ts",
		"verify": "npm run gates && npm run lint && npm test && npm run check"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsqr": "^1.4.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^6.3.5",
		"vitest": "^3.2.4"
	},
	"license": "MIT",
	"description": "Turn spreadsheet rows into print-ready cards, entirely in the browser."
}
