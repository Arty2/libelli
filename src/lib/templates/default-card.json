{
  "schema": 5,
  "name": "A5 Starter Template",
  "page": {
    "w": 148,
    "h": 210,
    "unit": "mm"
  },
  "bleed": {
    "enabled": false,
    "amount": 3,
    "cropMarks": false
  },
  "pageNumber": {
    "enabled": true,
    "position": "bottom-outer",
    "margin": 8
  },
  "fonts": [
    {
      "family": "Instrument Sans",
      "source": "google"
    },
    {
      "family": "Fraunces",
      "source": "google"
    },
    {
      "family": "Patrick Hand",
      "source": "google"
    }
  ],
  "defaults": {
    "font": "Instrument Sans",
    "size": 11,
    "lineHeight": 1.5,
    "weight": 400,
    "color": "#000000",
    "align": "left",
    "letterSpacing": 0
  },
  "slots": [
    "title",
    "subtitle",
    "body",
    "category",
    "link",
    "accent",
    "sketch"
  ],
  "boxes": [
    {
      "id": "b_accent",
      "slot": "accent",
      "x": 141,
      "y": 0,
      "w": 7,
      "h": 210,
      "mode": "color",
      "overflow": "clip",
      "hideWhenEmpty": true
    },
    {
      "id": "b_title",
      "slot": "title",
      "x": 12,
      "y": 13,
      "w": 96,
      "h": 16,
      "size": 34,
      "lineHeight": 1.05,
      "mode": "plain",
      "overflow": "grow",
      "hideWhenEmpty": true,
      "mirror": false,
      "font": "Fraunces",
      "weight": 300
    },
    {
      "id": "b_subtitle",
      "slot": "subtitle",
      "x": 12,
      "y": 31,
      "w": 96,
      "h": 8,
      "size": 13,
      "lineHeight": 1.3,
      "color": "#555555",
      "mode": "plain",
      "overflow": "grow",
      "anchor": {
        "to": "b_title",
        "gap": 2
      },
      "hideWhenEmpty": true,
      "mirror": false
    },
    {
      "id": "b_body",
      "slot": "body",
      "x": 12,
      "y": 44,
      "w": 124,
      "h": 110,
      "mode": "markdown",
      "overflow": "grow",
      "anchor": {
        "to": "b_subtitle",
        "gap": 8
      },
      "md": {
        "h1": {
          "size": 1.5,
          "spaceBefore": 6,
          "spaceAfter": 1.5
        },
        "h2": {
          "size": 1.35,
          "spaceBefore": 6,
          "spaceAfter": 1.5
        },
        "h3": {
          "size": 1.15,
          "spaceBefore": 4,
          "spaceAfter": 1
        },
        "paragraph": {
          "spaceAfter": 3
        },
        "list": {
          "indent": 7,
          "markerGap": 4,
          "itemSpacing": 1.5
        }
      },
      "paragraph": {
        "mode": "indent",
        "amount": 1
      }
    },
    {
      "id": "b_sketch",
      "slot": "sketch",
      "x": 110,
      "y": 11,
      "w": 26,
      "h": 26,
      "mode": "bitmap",
      "overflow": "clip",
      "fit": "contain",
      "hideWhenEmpty": true,
      "rotation": -7,
      "padding": 2,
      "borderWidth": 0.5,
      "borderStyle": "solid",
      "borderRadius": 2,
      "borderHand": true,
      "color": "#111111",
      "mirror": false
    },
    {
      "id": "b_category",
      "slot": "category",
      "x": 12,
      "y": 196,
      "w": 34,
      "h": 7,
      "font": "Patrick Hand",
      "size": 12.5,
      "lineHeight": 1.1,
      "align": "center",
      "valign": "middle",
      "background": "#ecece6",
      "borderRadius": 3.5,
      "color": "#333333",
      "mode": "plain",
      "overflow": "clip",
      "anchor": null
    },
    {
      "id": "b_date",
      "slot": null,
      "x": 54,
      "y": 196,
      "w": 40,
      "h": 7,
      "size": 7.5,
      "lineHeight": 1.2,
      "color": "#777777",
      "valign": "middle",
      "mode": "plain",
      "overflow": "clip",
      "anchor": null,
      "static": {
        "text": "{{date:YYYY-MM-DD}}"
      },
      "align": "center",
      "letterSpacing": 0.2
    },
    {
      "id": "b_qr",
      "slot": "link",
      "x": 112,
      "y": 186,
      "w": 20,
      "h": 20,
      "mode": "qr",
      "overflow": "clip",
      "anchor": null,
      "hideWhenEmpty": true,
      "fit": "contain",
      "color": "#000000",
      "padding": 1,
      "qr": {
        "level": "M"
      }
    }
  ],
  "facing": true
}
