{
  "schema": 5,
  "name": "A5 Starter",
  "page": {
    "w": 148,
    "h": 210,
    "unit": "mm",
    "background": "#ffffff",
    "margin": {
      "top": 11,
      "right": 14,
      "bottom": 8,
      "left": 14
    }
  },
  "bleed": {
    "enabled": false,
    "amount": 3,
    "cropMarks": false
  },
  "pageNumber": {
    "enabled": true,
    "position": "bottom-outer",
    "margin": 9
  },
  "fonts": [
    {
      "family": "Instrument Sans",
      "source": "google"
    },
    {
      "family": "Fraunces",
      "source": "google"
    },
    {
      "family": "Ysabeau Office",
      "source": "google"
    },
    {
      "family": "IBM Plex Mono",
      "source": "google"
    }
  ],
  "defaults": {
    "font": "Instrument Sans",
    "size": 10,
    "lineHeight": 1.45,
    "weight": 400,
    "color": "#1c1b19",
    "align": "left",
    "letterSpacing": 0
  },
  "slots": [
    "title",
    "subtitle",
    "body",
    "category",
    "link",
    "accent",
    "sketch"
  ],
  "boxes": [
    {
      "id": "b_accent",
      "slot": "accent",
      "x": 142,
      "y": 0,
      "w": 6,
      "h": 210,
      "mode": "color",
      "overflow": "clip",
      "hideWhenEmpty": true,
      "blend": "multiply"
    },
    {
      "id": "b_category",
      "slot": "category",
      "x": 14,
      "y": 11,
      "w": 90,
      "h": 5,
      "font": "IBM Plex Mono",
      "size": 6.5,
      "lineHeight": 1.2,
      "letterSpacing": 0.35,
      "textCase": "uppercase",
      "color": "#6b675f",
      "valign": "bottom",
      "padding": {
        "top": 0,
        "right": 0,
        "bottom": 1.5,
        "left": 0
      },
      "borderWidth": {
        "top": 0,
        "right": 0,
        "bottom": 0.2,
        "left": 0
      },
      "borderStyle": "solid",
      "borderColor": "#b9b4a8",
      "mode": "plain",
      "overflow": "clip",
      "hideWhenEmpty": true,
      "mirror": false
    },
    {
      "id": "b_title",
      "slot": "title",
      "x": 14,
      "y": 21,
      "w": 90,
      "h": 14,
      "font": "Fraunces",
      "size": 30,
      "weight": 360,
      "lineHeight": 1.04,
      "letterSpacing": -0.25,
      "mode": "plain",
      "overflow": "grow",
      "anchor": {
        "to": "b_category",
        "gap": 5
      },
      "hideWhenEmpty": true,
      "mirror": false
    },
    {
      "id": "b_subtitle",
      "slot": "subtitle",
      "x": 14,
      "y": 37,
      "w": 90,
      "h": 7,
      "font": "Ysabeau Office",
      "size": 13,
      "weight": 300,
      "lineHeight": 1.25,
      "color": "#55514a",
      "mode": "plain",
      "overflow": "grow",
      "anchor": {
        "to": "b_title",
        "gap": 2.5
      },
      "hideWhenEmpty": true,
      "mirror": false
    },
    {
      "id": "b_body",
      "slot": "body",
      "x": 14,
      "y": 52,
      "w": 120,
      "h": 120,
      "mode": "markdown",
      "overflow": "grow",
      "anchor": {
        "to": "b_subtitle",
        "gap": 8
      },
      "md": {
        "h1": {
          "size": 1.6,
          "spaceBefore": 5,
          "spaceAfter": 1.5,
          "weight": 500
        },
        "h2": {
          "size": 1.4,
          "spaceBefore": 5,
          "spaceAfter": 1.2,
          "weight": 500
        },
        "h3": {
          "size": 1.15,
          "spaceBefore": 4,
          "spaceAfter": 1,
          "weight": 500
        },
        "paragraph": {
          "spaceAfter": 3
        },
        "list": {
          "indent": 6,
          "markerGap": 3,
          "itemSpacing": 1.2
        },
        "rule": {
          "spaceBefore": 4,
          "spaceAfter": 4,
          "color": "#cfcabe"
        }
      },
      "paragraph": {
        "mode": "indent",
        "amount": 1
      },
      "list": {
        "marker": "emdash"
      }
    },
    {
      "id": "b_sketch",
      "slot": "sketch",
      "x": 109,
      "y": 10,
      "w": 26,
      "h": 26,
      "mode": "image",
      "overflow": "clip",
      "fit": "contain",
      "hideWhenEmpty": true,
      "rotation": -7,
      "padding": 3,
      "borderWidth": 0.3,
      "borderStyle": "stamp",
      "borderHand": true,
      "background": "#ffffff",
      "color": "#1c1b19",
      "mirror": false,
      "borderColor": "#8a857b"
    },
    {
      "id": "b_link",
      "slot": null,
      "x": 26,
      "y": 194,
      "w": 80,
      "h": 4,
      "font": "IBM Plex Mono",
      "size": 6.5,
      "lineHeight": 1.2,
      "color": "#1c1b19",
      "valign": "bottom",
      "mode": "plain",
      "overflow": "clip",
      "hideWhenEmpty": true,
      "static": {
        "text": "{{link}}"
      },
      "align": "right"
    },
    {
      "id": "b_date",
      "slot": null,
      "x": 26,
      "y": 198.5,
      "w": 80,
      "h": 4,
      "font": "IBM Plex Mono",
      "size": 6.5,
      "lineHeight": 1.2,
      "color": "#8a857b",
      "letterSpacing": 0.15,
      "valign": "bottom",
      "mode": "plain",
      "overflow": "clip",
      "static": {
        "text": "Printed {{date:YYYY-MM-DD}}"
      },
      "align": "right"
    },
    {
      "id": "b_qr",
      "slot": "link",
      "x": 110,
      "y": 181,
      "w": 21,
      "h": 21,
      "mode": "qr",
      "overflow": "clip",
      "hideWhenEmpty": true,
      "fit": "contain",
      "color": "#1c1b19",
      "padding": 1,
      "qr": {
        "level": "M"
      }
    }
  ],
  "facing": true,
  "css": "/* The page number takes the page's own face; this sets it in the mono of the footer. */\n.page-number {\n  font-family: 'IBM Plex Mono', monospace !important;\n  font-size: 6.5pt !important;\n  letter-spacing: 0.3mm;\n  color: #8a857b !important;\n}\n\n/* Headings inside the body in the title's serif. */\n#body h1, #body h2, #body h3 {\n  font-family: 'Fraunces', serif;\n  letter-spacing: -0.1mm;\n}\n\n/* `code` in the footer's mono, on a faint chip. */\n#body code {\n  font-family: 'IBM Plex Mono', monospace;\n  font-size: 0.86em;\n  background: #efece4;\n  padding: 0 0.6mm;\n  border-radius: 0.6mm;\n}\n\n/* The drawing's stamp, lifted off the page. A drop-shadow follows what is\n   painted, so it traces the perforations; a box-shadow would be a rectangle. */\n#sketch {\n  filter: drop-shadow(0.4mm 0.7mm 0.6mm rgba(40, 30, 10, 0.28));\n}\n\n#body mark {\n  background: #f6e27a;\n  padding: 0 0.4mm;\n}\n"
}
